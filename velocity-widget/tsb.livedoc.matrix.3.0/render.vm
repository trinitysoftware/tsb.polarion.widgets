## ==========================================================================
## Fetching data using Velocity maps, then passing
## those maps to Javascript for DataTables.
## ==========================================================================
#macro ( prepareDataRowsMacro )
    ## ======================================================================
    ## $dataRows stores all table rows.
    ## Each $rowsMap inside it stores one table row.
    ## ======================================================================
    #set ( $dataRows = [] )

    ## ======================================================================
    ## Create one row map for each document.
    ## ======================================================================
    #foreach ( $docu in $docItems )
        #set ( $indexLoop = $velocityCount - 1 )
        #set ( $docQuery = $docQueries.get($indexLoop) )

        ## ==================================================================
        ## This map stores all cells for the current row.
        ## key = column id, value = rendered cell content.
        ## ==================================================================
        #set ( $rowsMap = $objectFactory.newMap() )

        #set ( $spaceHtml = "" )
        #set ( $projectHtml = "" )
        #set ( $signatureHtml = "" )

        #if ( true == $parameters.showProject.value() )
            #set ( $projectHtml = "$!docu.fields().project().render()")
            #set ( $void = $rowsMap.put("project", $projectHtml) )
        #end

        #if ( true == $parameters.showSpace.value() )
            #set ( $spaceHtml = "$!docu.space().render()" )
            #set ( $void = $rowsMap.put("space", $spaceHtml) )
        #end

        #set ( $documentHtml = $docu.render().withIcon().withLinks(true) )
        #set ( $void = $rowsMap.put("documentHtml", $documentHtml) )

        #if ( true == $parameters.showSignaturesStatus.value() )
            #set ( $workflowSignatures = $docu.fields().workflowSignatures().toArrayList )
            
            #foreach( $row in $workflowSignatures )
                #set ( $signatureStatus = $row.fields().signatureState().optionId() )
                #if ( !($signatureStatus.equals("obsolete")) && !($signatureStatus.equals("notAvailable")) )
                    #set ( $renderedSignature = $row.render().htmlFor().forFrame().replace(", ", "") )
                    #set ( $signatureHtml = "${signatureHtml}<span style='margin: 1px;'>${renderedSignature}</span>" )
                #end
            #end
    
            #set ( $void = $rowsMap.put("signatureHtml", $signatureHtml) )
        #end

        #set ( $fieldsId = $parameters.columnFields.value().split(",") )
        #foreach ( $fieldIdRaw in $fieldsId )
            #set ( $fieldId = $fieldIdRaw.trim() )
            #if ( !$fieldId.equals("") )
                #set ( $fieldHtml = "$!docu.fields().get($fieldId).render()" )
                #set ( $void = $rowsMap.put($fieldId, $fieldHtml) )
            #end
        #end
        
        #foreach ( $columnParam in $parameters.columns.get() )
            #if ( !($columnParam.title.value() == "") && !($columnParam.query.value() == "") )
                #set ( $cellQuery = "$docQuery AND ($columnParam.query.value())" )
                #set ( $workitemCount = $transaction.workItems().search().query("$cellQuery").size() )
                #set ( $trackerLink = $transaction.context().createPortalLink().project("$docu.fields().project().projectId()").workItems().query("$cellQuery").toEncodedRelativeUrl() )
                #set ( $docSpace = $docu.getOldApi().getModuleFolder() )
                #set ( $docName = $docu.fields().moduleName().get() )
                #set ( $docLink = $transaction.context().createPortalLink().project("$docu.fields().project().projectId()").document("$docSpace","$docName").filter("$cellQuery").toEncodedRelativeUrl() )
               
                #set ( $cellHtml = "<a href=$q$trackerLink$q>$workitemCount</a> / <a href=$q$docLink$q>Doc</a>" )
                #set ( $void = $rowsMap.put($columnParam.title.value(), $cellHtml) )
            #end
        #end

        ## ==================================================================
        ## The row is complete.
        ## Add it to the list of all rows.
        ## ==================================================================
        #set ( $void = $dataRows.add($rowsMap) )
    #end
#end

## =================================
## Main 
## =================================
#if ( $allowRendering )
    ## Step 1: collect documents.
    #prepareRowsMacro()

    ## Step 2: build header and row maps.
    #prepareHeadersMacro()
    #prepareDataRowsMacro()

    #initDataTableMacro ( $widgetTableId $headersKeys $headersMap $dataRows )
#end
