#macro ( renderTableMountMacro )
    ## This is the empty table element.
    ## DataTables will fill it using widgetData.
    <table id="$widgetTableId" style="width:100%;table-layout:fixed;"></table>
#end

#macro ( renderWidgetDataMacro )
<script type="text/javascript">
    // This object is passed to DataTables.
    // headers stores the columns; rows stores the row data.
    var widgetData = {
        headers: [],
        rows: []
    };

    // Convert the Velocity headers map into JavaScript header objects.
    // Example: "space" -> "Space" becomes { key: "space", title: "Space" }.
    #foreach ( $headerKey in $headersMap.keySet() )
        widgetData.headers.push({
            title: "$esc.javascript($headersMap.get($headerKey))",
            key: "$esc.javascript($headerKey)"
        });
    #end

    // Convert each Velocity row map into a JavaScript row object.
    // Each Velocity row map becomes one JavaScript row object.
    #foreach ( $rowMap in $dataRows )
        var rowData = {};

        // Copy every cell from the row map into the JavaScript row object.
        #foreach ( $rowKey in $rowMap.keySet() )
            rowData["$esc.javascript($rowKey)"] = "$esc.javascript($rowMap.get($rowKey))";
        #end

        // This row is ready. Give it to DataTables' row list.
        widgetData.rows.push(rowData);
    #end
</script>
#end

#macro ( initDataTableMacro )
<script type="text/javascript">
(function () {
    // Find our table shell by its unique id.
    // The unique id lets this widget find its own table.
    var tableEl = document.getElementById('$widgetTableId');

    // If the table or data is missing, stop quietly.
    if (!tableEl || typeof widgetData === 'undefined') {
        return;
    }

    // DataTables wants columns in this shape:
    // { title: "Human label", data: "rowObjectKey" }
    var columns = widgetData.headers.map(function (header) {
        return {
            title: header.title,
            data: header.key
        };
    });

    // Finally: build the interactive table.
    // DataTables reads each row using the keys from columns.data.
    new DataTable(tableEl, {
        columns: columns,
        data: widgetData.rows
    });
})();
</script>
#end

