## ==========================================================================
## OVERVIEW — tsb.livedoc.matrix — render.vm
##
## Pipeline (three stages, all in this file):
##
##   STAGE 1 — Velocity fetches document data and renders the table skeleton
##             (thead with headers, empty tbody).
##             Key output: <table id="widget-table">
##
##   STAGE 2 — Velocity serializes each document row into a JavaScript
##             variable defined directly in a <script> block.
##             Key output: var widgetRows = [ {...}, {...}, ... ];
##
##   STAGE 3 — JavaScript reads widgetRows (from STAGE 2) and populates
##             the table tbody (from STAGE 1) via DataTables.
##             Fallback: plain JS renderer if DataTables fails to load.
##
## IMPORTANT — Resource loading:
##   Polarion widget sandboxes block <script src> and <link href> for widget-local
##   files. Resources MUST be loaded via XHR + eval (JS) or XHR + innerHTML (CSS).
##   This matches the pattern used in all production Polarion widgets.
## ==========================================================================

## ==========================================================================
## STAGE 0 — Read widget parameters and guard against missing project scope
## ==========================================================================
#set ( $warnSingleProject = "This widget renders a document matrix for <b>single Projects only</b>. Please select a <b>single Project</b> for the <b>Scope parameter</b>." )

#set ( $allowRendering = true )
#set ( $projectId = $parameters.dataSet.scope().projectId() )
#set ( $docsQuery = $parameters.dataSet.getFor().revision("").queryToShow() )

#if ( !$projectId )
    $widgetContext.renderWarning("$warnSingleProject")
    #set ( $allowRendering = false )
#end

## Lists populated while preparing document rows and optional query columns.
## $rowTitles is rendered later; query-column lists are collected but not currently displayed.
#set ( $columnTitles = [] )
#set ( $columnQueries = [] )
#set ( $rowTitles = [] )
#set ( $rowQueries = [] )

## ==========================================================================
## STAGE 1 — Velocity: prepare data, render table skeleton, and load resources
## ==========================================================================

#macro ( prepareColumnsMacro )
    ## -----------------------------------------------------------
    ## Reads the "Additional Columns" repeatable parameter.
    ## These values are collected for query-column support, but this render path
    ## does not currently add those columns to the table.
    ## -----------------------------------------------------------
    #foreach ( $columnParam in $parameters.columns.get() )
        #if ( !($columnParam.title.value() == "") && !($columnParam.query.value() == "") )
            ## #set ( $void = $columnTitles.add($columnParam.title.value()) )
            ## #set ( $void = $columnQueries.add($columnParam.query.value()) )
        #end
    #end
#end

#macro ( prepareRowsMacro )
    ## ----------------------------------------------------------------------
    ## Searches for documents matching $docsQuery.
    ## Each result document is added to $rowTitles as one future table row.
    ## $rowTitles is used by renderTableHeaderMacro for field labels
    ## and by renderTableRowsJsMacro to serialize row data.
    ## ----------------------------------------------------------------------
    #set ( $q = '"' )
    #set ( $docs = $transaction.documents().search().query($docsQuery).sort("project.id space.id title") )
    #foreach ( $doc in $docs )
        #set ( $void = $rowTitles.add($doc) )
        #set ( $docNameWithSpace = $doc.getOldApi().getRelativePath().replace("_default/","") )
        #set ( $void = $rowQueries.add("(project.id:$projectId AND (NOT type:heading) AND document.id:$q$docNameWithSpace$q)") )
    #end
#end

## ==========================================================================
## STAGE 1 — Velocity: render the table skeleton
## <thead> is filled by renderTableHeaderMacro below.
## <tbody> is left empty here — STAGE 3 (JavaScript) fills it at runtime.
## The table id="widget-table" is the connection point to STAGE 3.
## ==========================================================================

#macro ( renderTableStartMacro )
    <table id="widget-table"
           style="margin:auto;empty-cells:show;border-collapse:collapse;width:100%;border:1px solid #CCCCCC;">
        <thead>
#end

#macro ( renderTableEndMacro )
    </thead>
    <tbody></tbody>
    ## ----------------------------------------------------------------------------
    ## STAGE 3 fills this tbody from widgetRows (defined in STAGE 2).
    ## ----------------------------------------------------------------------------
</table>
#end

#macro ( renderTableHeaderMacro )
    ## ----------------------------------------------------------------------------
    ## Renders the <thead> <tr> with one <th> per column.
    ## Field column titles are resolved from the first document in $rowTitles
    ## so labels (e.g. "Status", "Updated") match the Polarion field definition.
    ## ----------------------------------------------------------------------------
    <tr>
        #if ( $parameters.showProject.value() == true )
            <th style='text-align:left;vertical-align:top;height:10px;border:1px solid #CCCCCC;padding:3px;background-color:#d3d3d3;min-width:120px;'>Project</th>
        #end

        #if ( $parameters.showSpace.value() == true )
            <th style='text-align:left;vertical-align:top;height:10px;border:1px solid #CCCCCC;padding:3px;background-color:#d3d3d3;min-width:150px;'>Space</th>
        #end

        <th style='text-align:left;vertical-align:top;height:10px;border:1px solid #CCCCCC;padding:3px;background-color:#d3d3d3;'>Document</th>

        #set ( $fieldsId = $parameters.columnFields.value().split(",") )

        ## ------------------------------------------------------------
        ## This is for getting the first document. 
        ## If it's greater than zero, which means there are two or more
        ## number of documents inside, we get the first one of index zero
        ## ------------------------------------------------------------
        #set ( $firstDoc = "" )
        #if ( $rowTitles.size() > 0 )
            #set ( $firstDoc = $rowTitles.get(0) )
        #end

        #foreach ( $f in $fieldsId )
            #set ( $fieldId = $f.trim() )
            #if ( !$fieldId.equals("") )
            ## ------------------------------------------------------------
            ## Use the Polarion field label if a document is available;
            ## otherwise fall back to the raw field ID as the header text.
            ## ------------------------------------------------------------
            #set ( $fieldLabel = $fieldId )
            #if ( $firstDoc != "" )
                #set ( $fieldLabel = "$!firstDoc.fields().get( $fieldId ).name()" )
                #if ( "$!fieldLabel" == "" || $fieldLabel.contains("@") )
                    #set ( $fieldLabel = $fieldId )
                #end
            #end
            <th style='text-align:center;vertical-align:top;height:10px;border:1px solid #CCCCCC;padding:3px;background-color:#d3d3d3;'>$fieldLabel</th>
            #end
        #end
    </tr>
#end

## ==========================================================================
## STAGE 1 — Load CSS and JS dependencies via XHR
##
## WHY XHR + eval / innerHTML and NOT <script src> or <link href>:
##   Polarion's widget sandbox does not serve widget-local resource files
##   via a URL that <script src> can reach at page-render time.
##   XHR using the URL from $widgetContext.resourceUrl() is the only
##   supported method for loading widget-bundled files. This is the same
##   pattern used by all production Polarion Velocity widgets.
##
##   datatables.js  — provides the DataTable constructor used in STAGE 3
##   datatables.css — styles the table rendered by DataTables in STAGE 3
## ==========================================================================

#macro ( loadWidgetJsResource $js )
    #loadJsResource($widgetContext.resourceUrl("$js"))
#end

#macro ( loadJsResource $url )
    ## ----------------------------------------------------------------------------
    ## Synchronous XHR fetch and eval — required for Polarion widget resources.
    ## ----------------------------------------------------------------------------
    <script type="text/javascript">
        var xhrObj = new XMLHttpRequest();
        xhrObj.open('GET', '$url', false);
        xhrObj.send(null);
        eval(xhrObj.responseText);
    </script>
#end

#macro ( loadWidgetCssResource $css )
    #loadCssResource( $widgetContext.resourceUrl("$css") )
#end

#macro ( loadCssResource $url )
    ## ----------------------------------------------------------------------------
    ## Synchronous XHR fetch injected into a <style> tag — required for Polarion widget resources.
    ## ----------------------------------------------------------------------------
    #set ( $cssId = $widgetContext.generateUniqueElementId() )

    <style id="$cssId"></style>

    <script type="text/javascript">
        var xhrObj = new XMLHttpRequest();
        xhrObj.open('GET', '$url', false);
        xhrObj.send(null);
        document.getElementById("$cssId").innerHTML = xhrObj.responseText;
    </script>
#end

#loadWidgetCssResource( "resources/datatables.css" )
#loadWidgetJsResource( "resources/datatables.js" )

## ==========================================================================
## STAGE 2 — Velocity → JavaScript variable
##
## Velocity iterates $rowTitles (populated in STAGE 1) and builds a JS array
## literal, var widgetRows = [...], embedded directly in a <script> block.
##
## Escaping: $esc.javascript() safely encodes all special characters
##   (backslash, double-quote, control characters) for embedding inside
##   a JavaScript string literal enclosed in double-quotes.
##
## Connection to STAGE 3: the variable name widgetRows is read directly
##   by initDataTableMacro — no JSON.parse() step is needed.
## ==========================================================================

#macro ( renderTableRowsJsMacro )
    <script type="text/javascript">
    var widgetRows = [
    #set ( $firstRow = true )
    #set ( $fieldsId = $parameters.columnFields.value().split(",") )

    #foreach ( $rowTitle in $rowTitles )
        #if ( !$firstRow ),#end
        #set ( $firstRow = false )

        #set ( $spaceHtml = "" )
        #set ( $projectHtml = "" )

        #if ( true == $parameters.showProject.value() )
            ## ----------------------------------------------------------------------------
            ## Render the project field with Polarion instead of manually reading its label.
            ## ----------------------------------------------------------------------------
            #set ( $projectField = $rowTitle.fields().project() )
            #if ( $projectField )
                #set ( $projectHtml = "$!projectField.render()" )
            #end
        #end

        #if ( true == $parameters.showSpace.value() )
            ## ----------------------------------------------------------------------------
            ## Extracts the document space from the document relative path.
            ## Example: "_default/MyDoc", "System/MyDoc", or "Requirements/System Requirements"
            ## Since the part before the first / is the Space, the part after it is the 
            ## document name or path.
            ##
            ## _default is the fallback value in case there is nothing from the relativePath.
            ##
            ## This line of code: 
            ##      $spaceHtml = $relativePath.substring(0, $relativePath.indexOf("/"))
            ## becomes Requirements. It takes everything before the first /.
            ##
            ## RATIONALE:
            ## We did all this instead of using $rowTitle.fields().space().render() because 
            ## space is not readily available through it. Tried it once - did not render anything.
            ## So what I did is: getRelativePath() as it contains both space and document path,
            ## then extracted the text before / to get the Space value for the table.
            ## ----------------------------------------------------------------------------
            
            #set ( $relativePath = "$!rowTitle.getOldApi().getRelativePath()" )
            #set ( $spaceHtml = "_default" )
            #if ( $relativePath.contains("/") )
                #set ( $spaceHtml = $relativePath.substring(0, $relativePath.indexOf("/")) )
            #end
        #end

        ## ------------------------------------------------------------------------------------
        ## .render().withIcon().withLinks(true) produces an <a> tag with icon for the document.
        ## This HTML is stored as a JS string and injected via innerHTML in STAGE 3.
        ## ------------------------------------------------------------------------------------
        #set ( $documentHtml = $rowTitle.render().withIcon().withLinks(true) )

        {
            "project":      "$esc.javascript($projectHtml)",  // Contains the rendered Project value. It may include HTML from Polarion.
            "space":        "$esc.javascript($spaceHtml)",    // Contains the Space value extracted earlier from the document path, for example _default or Requirements.
            "documentHtml": "$esc.javascript($documentHtml)", // Contains the rendered document link, including icon and clickable link HTML.
            "fields": {                                       // Contains the configured extra document fields from columnFields, such as status, updated, or author.
                #set ( $firstField = true )
                #foreach ( $fieldIdRaw in $fieldsId )
                    #set ( $fieldId = $fieldIdRaw.trim() )
                    #if ( !$fieldId.equals("") )
                        ## ----------------------------------------------------------------------------
                        ## Let Polarion render the field value server-side.
                        ## JavaScript receives display-ready HTML and puts it into the table cell.
                        ##
                        ## fieldHtml is the display-ready HTML value of one document field.
                        ## ----------------------------------------------------------------------------

                        #set ( $fieldValue = $rowTitle.fields().get($fieldId) )
                        #set ( $fieldHtml = "" )

                        #if ( $fieldValue )
                            #set ( $fieldHtml = "$!fieldValue.render()" )
                        #end

                        #if ( !$firstField ),#end
                        #set ( $firstField = false )

                        #set ( $fieldValueJs = "null" )
                        #if ( "$!fieldHtml" != "" )
                            #set ( $quote = '"' )
                            #set ( $fieldValueJs = "${quote}$esc.javascript($fieldHtml)${quote}" )
                        #end

                        "$esc.javascript($fieldId)": $fieldValueJs
                    #end
                #end
            }
        }
    #end
    ];
    </script>
#end

## ==========================================================================
## STAGE 3 — JavaScript: read widgetRows and populate the table
##
## Reads the JS variable widgetRows defined in STAGE 2.
## Builds a flat cell array per row (matching column order from STAGE 1 headers).
## Initialises DataTables on the table written by STAGE 1.
##
## If DataTables fails to load or throws, renderFallback() writes rows
## directly into <tbody> so data is always visible.
## ==========================================================================

#macro ( initDataTableMacro )
    <script type = "text/javascript">

    (function () {

        /*
            STAGE 3a: Locate the table written by STAGE 1
            widget-table can be traced back to 
        */
        var tableEl = document.getElementById( 'widget-table' );
        if ( !tableEl ) {
            console.error('tsb.livedoc.matrix: table element #widget-table not found');
            return;
        }

        /*
            STAGE 3b: verify the data variable written by STAGE 2
            widgetRows is defined in the <script> block emitted by renderTableRowsJsMacro.
        */
        if ( typeof widgetRows === 'undefined' ) {
            console.error('tsb.livedoc.matrix: widgetRows is not defined — STAGE 2 did not emit');
            return;
        }
        
        var showProject = $parameters.showProject.value();
        var showSpace = $parameters.showSpace.value();

        /*
            fieldIds must match the order of field <th> elements in renderTableHeaderMacro.
        */

        #set ( $fieldIdsJs = "" )
        #set ( $jsFirst = true )

        /*
            Builds the JavaScript fieldIds array from the comma-separated columnFields widget parameter.

            Example: status, updated, author
            becomes: var fieldIds = ['status','updated','author'];

            It trims spaces, skips empty values, escapes each field ID for JavaScript, and inserts commas only between valid entries.
        */

        #foreach ( $fieldIdRaw in $parameters.columnFields.value().split(",") )
            #set ( $fieldId = $fieldIdRaw.trim() )
            #if ( !$fieldId.equals("") )
                #if ( !$jsFirst )
                    #set ( $fieldIdsJs = "${fieldIdsJs}," )
                #end
                #set ( $fieldIdsJs = "${fieldIdsJs}'$esc.javascript($fieldId)'" )
                #set ( $jsFirst = false )
            #end
        #end

        var fieldIds = [$fieldIdsJs];

        /*
            docColIdx = zero-based index of the Document column.
            Used by the fallback renderer to left-align the Document cell.

            If showProject == true, value is 1. Else, 0.
            If showSpace == true, value is 1. Else, 0.
        */
        var docColIdx = (showProject ? 1 : 0) + (showSpace ? 1 : 0);

        /* 
            STAGE 3d: Converts each row object into a cell array
            Column order: [Project?] [Space?] Document [field1] [field2] ...
        */
        var tableData = widgetRows.map(function (row) {
            var cells = [];

            /*
                Add optional Project and Space columns before the Document column.

                If the statement is true, row.project is added to the cells
                Otherwise, nothing - empty.
            */
            if ( showProject )
                cells.push( row.project || '');
            if ( showSpace )
                cells.push( row.space || '');
                cells.push(row.documentHtml  || '');
            fieldIds.forEach( function (fid) {
                /*
                    Add the rendered field value when present; otherwise add an empty cell.

                    If this condition: row.fields && row.fields[fid] != null is true,
                    the converted string row.fields[fid] will be pushed to the cells.
                    Otherwise, none. Blank. 
                */
                cells.push(row.fields && row.fields[fid] != null ? String(row.fields[fid]) : '');
            });
            return cells;
        });
    })();
    </script>
#end

## ==========================================================================
## Main — invoke all three stages in order
## ==========================================================================
#if ( $allowRendering )
    ## ----------------------------------------------------------------------
    ## STAGE 1a: collect optional column parameters and fetch documents
    ## ----------------------------------------------------------------------
    #prepareColumnsMacro()
    #prepareRowsMacro()

    ## ----------------------------------------------------------------------
    ## STAGE 1b: render table with headers and empty tbody
    ## ----------------------------------------------------------------------
    #renderTableStartMacro()
    #renderTableHeaderMacro()
    #renderTableEndMacro()

    ## ----------------------------------------------------------------------
    ## STAGE 2: write widgetRows JS variable (read by STAGE 3)
    ## ----------------------------------------------------------------------
    #renderTableRowsJsMacro()

    ## ----------------------------------------------------------------------
    ## STAGE 3: JS reads widgetRows and populates tbody via DataTables
    ## ----------------------------------------------------------------------
    #initDataTableMacro()
#end
