## ==========================================================================
## OVERVIEW — tsb.livedoc.matrix — parameters.vm
## ==========================================================================

## ==========================================================================
## Build Data Set Parameter
## ==========================================================================
$parameters.put("dataSet", $factory.dataSet("Data Set").prototype().document().allowedPrototypes(["Document"]).build())

## --------------------------------------------------------------------------
## dependencySource = allows the script to process dependencies (parent-child items) - can be used to include the entire linked structure
## When we create a report, we can pull user stories, evaluate their status, which document it is linked to, etc.
## --------------------------------------------------------------------------

## ==========================================================================
## Parameters are the conditions or filters that we can see in the widget
## These can help filter the data accordingly - aligned with what users want to see
##
## These are just IDs and labels that we're initializing for later.
## ==========================================================================
$parameters.put("showSignaturesStatus", $factory.bool("Show Signatures Status").value(true).build())
$parameters.put("showProject", $factory.bool("Show Project").value(true).build())
$parameters.put("showSpace", $factory.bool("Show Space").value(true).build())
$parameters.put("columnFields", $factory.string("Show Fields as Columns").value("status,updated").build())

## ==========================================================================
## Build DataTables display and behavior parameters.
## These let users adjust table presentation from the widget properties
## panel without changing Velocity or JavaScript files.
## ==========================================================================
$parameters.put("tableHeight", $factory.string("Table Height").value("60vh").build())
$parameters.put("headerBackgroundColor", $factory.string("Header Background Color").value("#ffffff").build())
$parameters.put("headerTextColor", $factory.string("Header Text Color").value("#111827").build())
$parameters.put("rowBackgroundColor", $factory.string("Row Background Color").value("#ffffff").build())
$parameters.put("alternateRowBackgroundColor", $factory.string("Alternate Row Background Color").value("#f8fafc").build())
$parameters.put("showExportButtons", $factory.bool("Show Export Buttons").value(true).build())
$parameters.put("showSearchBar", $factory.bool("Show Search Bar").value(true).build())

## ==========================================================================
## Build Additional Column workitem queries
## ==========================================================================
#set ( $title = $factory.string("Title").build() )
#set ( $query = $factory.string("Query (Lucene)").value("").build() )
#set ( $composite = $factory.composite("Column Query").add("title", $title).add("query", $query).build() )
$parameters.put("columns", $factory.multi("Additional Columns", $composite).build())

## --------------------------------------------------------------------------
## SIDE NOTE: A composite groups related inputs into one reusable parameter block.
## Here, each block contains a column Title and a Lucene Query.
## Wrapping that composite in multi("Additional Columns", ...) lets users add
## multiple query columns in the widget configuration.
## --------------------------------------------------------------------------
