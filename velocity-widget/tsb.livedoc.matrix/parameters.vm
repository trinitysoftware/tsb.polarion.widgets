## OVERVIEW - tsb.livedoc.matrix - parameters.vm
## ===========================================================================
## ===========================================================================
## Build Data Set Parameter. The Data Set serves as the single source of truth
## for scope selection (single project, project group, collection, or global
## repository scope).
## ===========================================================================
#set ( $projectBaselineParam = $factory.customEnum("Project Baseline").allowNoValue(true).allowMultipleValues(false).dependencyTarget(true).build() )
#set ( $specificRevisionParam = $factory.string("Revision").value("").dependencyTarget(true).build() )
#set ( $collectionInheritanceParam = $factory.bool("Collection Inheritance").value(false).dependencyTarget(true).build() )

$parameters.put("dataSet", $factory.dataSet("Data Set").prototype().document().allowedPrototypes(["Document"]).allowCollectionScope(true).luceneQuery("").add("projectBaseline", $projectBaselineParam).add("specificRevision", $specificRevisionParam).add("collectionInheritance", $collectionInheritanceParam).dependencySource(true).build())

## ===========================================================================
## Define the matrix content parameters. dependencies.vm controls their dynamic
## visibility, and render.vm turns their stored values into the effective table.
## ===========================================================================
$parameters.put("matrixConfigurationPreset", $factory.customEnum("Recommended Preset").allowNoValue(false).allowMultipleValues(false).dependencySource(true).dependencyTarget(true).build())
$parameters.put("showSignaturesStatus", $factory.bool("Show Signatures Status").value(true).dependencyTarget(true).build())
$parameters.put("showDocumentBaselines", $factory.bool("Show Document Baselines").value(true).dependencyTarget(true).build())
$parameters.put("showBranchedDocuments", $factory.bool("Show Branched Documents").value(false).dependencyTarget(true).build())
$parameters.put("showMasterDocument", $factory.bool("Show Master Document").value(false).dependencyTarget(true).build())
$parameters.put("showUnresolvedComments", $factory.bool("Show Unresolved Comments").value(false).dependencyTarget(true).build())
$parameters.put("showUnreferencedWorkItems", $factory.bool("Show Recycle Bin").value(false).dependencyTarget(true).build())
$parameters.put("showApprovedVersions", $factory.bool("Show Approved Versions").value(true).dependencyTarget(true).build())
$parameters.put("showProject", $factory.bool("Show Project").value(true).dependencyTarget(true).build())
$parameters.put("showSpace", $factory.bool("Show Space").value(true).dependencyTarget(true).build())
$parameters.put("columnFields", $factory.string("Show Fields as Columns").value("status,updated").dependencyTarget(true).build())

## ===========================================================================
## Build DataTables display and behavior parameters.
## These let users adjust table presentation from the widget properties
## panel without changing Velocity or JavaScript files.
## ===========================================================================
$parameters.put("tableHeight", $factory.string("Table Height").value("60vh").dependencyTarget(true).build())
$parameters.put("headerBackgroundColor", $factory.string("Header Background Color").value("#ffffff").dependencyTarget(true).build())
$parameters.put("headerTextColor", $factory.string("Header Text Color").value("#111827").dependencyTarget(true).build())
$parameters.put("rowBackgroundColor", $factory.string("Row Background Color").value("#ffffff").dependencyTarget(true).build())
$parameters.put("alternateRowBackgroundColor", $factory.string("Alternate Row Background Color").value("#f8fafc").dependencyTarget(true).build())
$parameters.put("showExportButtons", $factory.bool("Show Export Buttons").value(true).dependencyTarget(true).build())
$parameters.put("showSearchBar", $factory.bool("Show Search Bar").value(true).dependencyTarget(true).build())
$parameters.put("showRisksheetLink", $factory.bool("Show Risksheet Link").value(false).dependencyTarget(true).build())
$parameters.put("enablePaging", $factory.bool("Enable Paging").value(false).dependencySource(true).build())
$parameters.put("rowsPerPage", $factory.integer("Rows Per Page").value(10).dependencyTarget(true).build())

## ===========================================================================
## Build Additional Column work item queries.
## ===========================================================================
#set ( $title = $factory.string("Title").build() )
#set ( $query = $factory.string("Query (Lucene)").value("").build() )
#set ( $composite = $factory.composite("Column Query").add("title", $title).add("query", $query).build() )
$parameters.put("columns", $factory.multi("Additional Columns", $composite).dependencyTarget(true).build())

## ---------------------------------------------------------------------------
## SIDE NOTE: A composite groups related inputs into one reusable parameter block.
## Here, each block contains a column Title, Lucene Query, and query behavior.
## Wrapping that composite in multi("Additional Columns", ...) lets users add
## multiple query columns in the widget configuration.
## ---------------------------------------------------------------------------
