    #set ( $dataSetCollectionScopeSelected = true )
#elseif ( $projectId || $scopePath || $dataSetScopeIsGlobal )
    #set ( $dataSetCollectionScopeSelected = false )
#elseif ( $dataSetCollectionReference )
    #set ( $dataSetCollectionScopeSelected = true )
#end

