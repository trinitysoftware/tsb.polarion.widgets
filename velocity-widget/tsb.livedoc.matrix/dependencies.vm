## ===========================================================================
## Validate the selected recommended matrix configuration preset.
## Custom Configuration keeps the existing manual fields and query columns.
## The other presets are applied at render time so user-entered custom values
## remain intact when switching back to Custom Configuration.
## ===========================================================================
#set ( $presetSetter = $parameters.matrixConfigurationPreset.set().clear().allowNoValue(false).allowMultipleValues(false) )
#set ( $void = $presetSetter.addEnumItem("custom", "Custom Configuration") )
#set ( $void = $presetSetter.addEnumItem("basicLiveDocStatus", "Basic LiveDoc Status") )
#set ( $void = $presetSetter.addEnumItem("reviewAndApproval", "Review and Approval") )
#set ( $void = $presetSetter.addEnumItem("traceabilityCounts", "Traceability Counts") )
#set ( $void = $presetSetter.addEnumItem("releaseReadiness", "Release Readiness") )
#set ( $presetValues = $parameters.matrixConfigurationPreset.values() )
#set ( $selectedPreset = "custom" )
#if ( !$presetValues.isEmpty() )
    #set ( $selectedPreset = "$!presetValues.get(0)" )
#end
#set ( $validPresetValues = ["custom", "basicLiveDocStatus", "reviewAndApproval", "traceabilityCounts", "releaseReadiness"] )
#if ( !$validPresetValues.contains($selectedPreset) )
    #set ( $selectedPreset = "custom" )
    #set ( $void = $presetSetter.singleValue("custom") )
#elseif ( $presetValues.isEmpty() )
    #set ( $void = $presetSetter.singleValue("custom") )
#end

## ===========================================================================
