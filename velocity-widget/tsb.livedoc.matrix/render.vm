## Translate user-facing widget parameters into a smaller settings map so
## the shared framework does not need to know every widget parameter.
## ==========================================================================
#macro ( prepareTableSettingsMacro )
    ## ======================================================================
    ## $tableSettings stores only values needed by DataTables and TableEffects.
    ## ======================================================================
    #set ( $tableSettings = $objectFactory.newMap() )

    #set ( $void = $tableSettings.put("tableHeight", $parameters.tableHeight.value()) )
    #set ( $void = $tableSettings.put("headerBackgroundColor", $parameters.headerBackgroundColor.value()) )
    #set ( $void = $tableSettings.put("headerTextColor", $parameters.headerTextColor.value()) )
    #set ( $void = $tableSettings.put("rowBackgroundColor", $parameters.rowBackgroundColor.value()) )
    #set ( $void = $tableSettings.put("alternateRowBackgroundColor", $parameters.alternateRowBackgroundColor.value()) )
    #set ( $void = $tableSettings.put("showExportButtons", $parameters.showExportButtons.value()) )
    #set ( $void = $tableSettings.put("showSearchBar", $parameters.showSearchBar.value()) )
    #set ( $void = $tableSettings.put("enablePaging", $parameters.enablePaging.value()) )
    #set ( $void = $tableSettings.put("rowsPerPage", $parameters.rowsPerPage.value()) )
#end

## ==========================================================================
## Main 
## ==========================================================================
#if ( $allowRendering )
    #prepareRowsMacro()

    #prepareFilterOptionsMacro()
    #prepareHeadersMacro()
    #prepareDataRowsMacro()
    #prepareTableSettingsMacro()

    ## ======================================================================
    ## Load widget-local DataTables assets.
    ## ======================================================================
    #loadWidgetCssResource("resources/datatables.css")
    #loadWidgetJsResource("resources/datatables.js")

    ## ======================================================================
    ## Load files for changing the effects or changing
    ## the design of the table.
    ## ======================================================================
    #loadWidgetJsResource("resources/tableEffects.js")
    #loadWidgetCssResource("resources/tableEffects.css")

    #initDataTableMacro ( $widgetTableId $headersKeys $headersMap $headerFilterTypesMap $headerFilterOptionsMap $dataRows $tableSettings )
#end
