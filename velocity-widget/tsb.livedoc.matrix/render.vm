#macro ( prepareRowsMacro )
    #if ( $dataSetCollectionScopeSelected )
        ## ===================================================================
        ## Collection mode renders from Collection elements directly. The Data
        ## Set's Collection tab can keep a SQL-shaped query internally, so using
        ## document search as the source can drop valid Collection documents.
        ## ===================================================================
        #foreach ( $rowDocumentKey in $collectionDocumentKeys )
            #set ( $rowDocument = $collectionDocumentMap.get($rowDocumentKey) )

            #if ( $rowDocument && !$rowDocument.isUnresolvable() )
                #set ( $rowProjectId = $rowDocument.fields().project().projectId() )
                #set ( $rowRevision = "$!collectionDocumentRevisionsMap.get($rowDocumentKey)" )

                #if ( $rowProjectId )
                    #set ( $docNameWithSpace = $rowDocument.getOldApi().getRelativePath().replace("_default/","") )

                    #if ( !$projectIds.contains($rowProjectId) )
                        #set ( $void = $projectIds.add($rowProjectId) )
                    #end

                    #set ( $void = $docItems.add($rowDocument) )
                    #set ( $void = $docRevisions.add($rowRevision) )

                    ## =======================================================
                    ## Build the work item query with the document's own project.
                    ## Equal document paths in different projects therefore keep
                    ## independent work item counts.
                    ## =======================================================
                    #set ( $void = $docQueries.add("(project.id:$rowProjectId AND (NOT type:heading) AND document.id:$q$docNameWithSpace$q)") )
                #end
            #end
        #end
    #else
        ## ===================================================================
        ## Execute the Data Set query through document search. This preserves
        ## Polarion's native scope, project group, query builder, and revision
        ## behavior; each returned row then supplies its own project context.
        ## ===================================================================
        #set ( $_docsSearch = $transaction.documents().search().query($documentQuery) )

        #if ( !$effectiveRevision.equals("") )
            #set ( $_docsSearch = $_docsSearch.baseline("$effectiveRevision") )
        #end

        #set ( $_docs = $_docsSearch.sort("project.id space.id title") )

        #foreach ( $_doc in $_docs )
            ## ===============================================================
            ## Skip unresolved documents because their fields and links cannot
            ## be rendered safely.
            ## ===============================================================
            #if ( !$_doc.isUnresolvable() && $_doc.can().read() )
                #set ( $rowProjectId = $_doc.fields().project().projectId() )
                #set ( $rowRevision = "$!effectiveRevision" )

                ## ===========================================================
                ## A valid project context is required for this document's work
                ## item query and portal links.
                ## ===========================================================
                #if ( $rowProjectId )
                    #if ( !$projectIds.contains($rowProjectId) )
                        #set ( $void = $projectIds.add($rowProjectId) )
                    #end

                    #set ( $void = $docItems.add($_doc) )
                    #set ( $void = $docRevisions.add($rowRevision) )

                    ## =======================================================
                    ## Polarion stores the default space with an "_default/"
                    ## prefix that is not part of document.id query values.
                    ## =======================================================
                    #set ( $docNameWithSpace = $_doc.getOldApi().getRelativePath().replace("_default/","") )

                    ## =======================================================
                    ## Build the work item query with the document's own project.
                    ## Equal document paths in different projects therefore keep
                    ## independent work item counts.
                    ## =======================================================
                    #set ( $void = $docQueries.add("(project.id:$rowProjectId AND (NOT type:heading) AND document.id:$q$docNameWithSpace$q)") )
                #end
            #end
        #end
    #end
#end

## ===========================================================================
## Resolve configured document field metadata once for all later table stages.
## Internal keys keep configured field ids separate from built-in column keys.
## Filter behavior comes from Polarion field types rather than field ids:
##   - date and date-time fields use the date-range control;
##   - enum, text, multi-value, unknown, or cross-project conflicts use
##     DataTables' row-derived list search.
##
## A field may be undefined or configured differently in another project.
## The list fallback keeps one DataTables column behavior safe for every row.
## ===========================================================================
#macro ( prepareFieldMetadataMacro )
    #set ( $columnFieldIds = [] )
    #set ( $fieldColumnKeysMap = $objectFactory.newMap() )
    #set ( $fieldTitlesMap = $objectFactory.newMap() )
    #set ( $fieldFilterTypesMap = $objectFactory.newMap() )

    #foreach ( $fieldIdRaw in $matrixColumnFields.split(",") )
        #set ( $fieldId = $fieldIdRaw.trim() )

        #if ( !$fieldId.equals("") && !$columnFieldIds.contains($fieldId) )
            #set ( $fieldColumnIndex = $columnFieldIds.size() )
            #set ( $fieldColumnKey = "documentField${fieldColumnIndex}" )
            #set ( $void = $columnFieldIds.add($fieldId) )
            #set ( $void = $fieldColumnKeysMap.put($fieldId, $fieldColumnKey) )
            #set ( $fieldTitle = $fieldId )
            #set ( $resolvedFilterType = "" )
            #set ( $hasTypeConflict = false )

            ## ===============================================================
            ## Inspect every represented document because custom field
            ## definitions can differ by project or document configuration.
            ## Undefined fields are ignored and render as empty cells later.
            ## ===============================================================
            #foreach ( $metadataDoc in $docItems )
                #set ( $renderingField = $metadataDoc.fields().get($fieldId) )

                #if ( $renderingField.is().defined() )
                    #if ( $fieldTitle.equals($fieldId) )
                        #set ( $fieldTitle = $renderingField.label() )
                    #end

                    ## =======================================================
                    ## getFieldType() supports both built-in and custom
                    ## fields. Only date-like primitives get a typed filter;
                    ## enum fields intentionally stay as row-derived lists so
                    ## users see only values present in the rendered table.
                    ## =======================================================
                    #set ( $oldApiDocument = $metadataDoc.getOldApi() )
                    #set ( $fieldType = $oldApiDocument.getFieldType($fieldId) )
                    #set ( $candidateFilterType = "list" )
                    #set ( $primitiveTypeName = "$!fieldType.getTypeName()" )

                    #if ( $primitiveTypeName.equals("java.util.Date") || $primitiveTypeName.equals("com.polarion.core.util.types.DateOnly") )
                        #set ( $candidateFilterType = "date" )
                    #end

                    ## =======================================================
                    ## One table column can have only one filter control.
