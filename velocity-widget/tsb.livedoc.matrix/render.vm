## =========================================
## Writes Velocity-generated JSON data into
## JavaScript for DataTables to get and render.
## The macro below creates a JS Object.
## remember, headersJson returns an array.
## so headers can have:
## headers: ["ID", "Title", "Status", "Severity"]
## The same goes for rowsJson.
## =========================================
#macro ( renderWidgetDataMacro )
<script type="text/javascript">
    var widgetData = {
        headers: #headersJson(),
        rows: #rowsJson($docItem)
    };
</script>
#end

#macro ( initDataTableMacro )
<script type="text/javascript">
(function () {
    var tableEl = document.getElementById('widget-table');

    if (!tableEl || typeof widgetData === 'undefined') {
        return;
    }
    /*
        This creates a columns array from widgetData.headers.
        For each header in widgetData.headers, it creates a new object like this:

        [
            { title: "ID", data: "id" },
            { title: "Name", data: "name" }
        ]
    */
    var columns = widgetData.headers.map(function (header) {
        return {
            title: header.title,
            data: header.key,
        };
    });

    new DataTable(tableEl, {
        columns: columns,
        data: widgetData.rows
    });
})();
</script>
#end

