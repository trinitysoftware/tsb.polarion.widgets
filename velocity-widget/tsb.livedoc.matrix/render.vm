## ==========================================================================
## Resolve document search criteria directly from the Data Set parameter.
## The Data Set parameter handles single project, project group, global scope,
## and multi-project project.id terms.
## ==========================================================================
#set ( $dataSetScope = $parameters.dataSet.scope() )
#set ( $projectId = $dataSetScope.projectId() )
#set ( $effectiveRevision = "" )
#set ( $revisionWarning = "" )

## ==========================================================================
## Resolve the revision context before any document or work item search runs.
## Empty revision means HEAD/current. Project Baseline selection takes
## precedence because its base revision is the authoritative snapshot point.
## Project Baseline options use revision|baselineName values. The selected
## revision applies to all documents represented by the Data Set.
## ==========================================================================
#set ( $projectBaselineValues = $parameters.projectBaseline.values() )
#set ( $specificRevision = $parameters.specificRevision.value().trim() )
#set ( $currentDocumentQuery = $parameters.dataSet.getFor().revision("").queryToShow() )

#if ( !$projectBaselineValues.isEmpty() )
    #set ( $projectBaselineValue = "$!projectBaselineValues.get(0)" )
    #set ( $projectBaselineValue = $projectBaselineValue.trim() )
    #set ( $projectBaselineSeparatorIndex = $projectBaselineValue.indexOf("|") )

    #if ( $projectBaselineSeparatorIndex > 0 )
        #set ( $selectedProjectBaselineIsValid = false )
        #set ( $scopeBaselineProjectIds = [] )

        #if ( $projectId )
            #set ( $void = $scopeBaselineProjectIds.add($projectId) )
        #else
            #set ( $scopeDocuments = $transaction.documents().search().query($currentDocumentQuery).sort("project.id") )

            #foreach ( $scopeDocument in $scopeDocuments )
                #if ( !$scopeDocument.isUnresolvable() )
                    #set ( $scopeProjectId = $scopeDocument.fields().project().projectId() )

                    #if ( $scopeProjectId && !$scopeBaselineProjectIds.contains($scopeProjectId) )
                        #set ( $void = $scopeBaselineProjectIds.add($scopeProjectId) )
                    #end
                #end
            #end
        #end

        #foreach ( $scopeBaselineProjectId in $scopeBaselineProjectIds )
            #set ( $scopeBaselineTrackerProject = $trackerService.getTrackerProject($scopeBaselineProjectId) )

            #if ( $scopeBaselineTrackerProject )
                #foreach ( $scopeProjectBaseline in $scopeBaselineTrackerProject.getBaselinesManager().getBaselines() )
                    #set ( $scopeBaselineName = "$!scopeProjectBaseline.getName()" )
                    #set ( $scopeBaselineRevision = "$!scopeProjectBaseline.getBaseRevision()" )

                    #if ( $scopeBaselineName.equals("") )
                        #set ( $scopeBaselineName = "$!scopeProjectBaseline.getId()" )
                    #end

                    #set ( $scopeBaselineValue = "$scopeBaselineRevision|$scopeBaselineName" )

                    #if ( $projectBaselineValue.equals($scopeBaselineValue) )
                        #set ( $selectedProjectBaselineIsValid = true )
                    #end
                #end
            #end
        #end

        #if ( $selectedProjectBaselineIsValid )
            #set ( $projectBaselineRevision = $projectBaselineValue.substring(0, $projectBaselineSeparatorIndex) )
            #set ( $effectiveRevision = $projectBaselineRevision.trim() )
        #else
            #set ( $revisionWarning = "Project Baseline '$projectBaselineValue' is not available in the current Data Set scope. Rows are rendered from HEAD." )
        #end
    #else
        ## Older saved configurations used projectId/baselineId values. They
        ## cannot identify a cross-project revision anymore, so fall back to HEAD.
        #set ( $revisionWarning = "Project Baseline '$projectBaselineValue' cannot be resolved. Rows are rendered from HEAD." )
    #end
#elseif ( !$specificRevision.equals("") )
    #set ( $effectiveRevision = $specificRevision )
#end

#set ( $documentQuery = $parameters.dataSet.getFor().revision("$!effectiveRevision").queryToShow() )
#set ( $q = '"' )

## ==========================================================================
## $docItems stores the LiveDocs found by the document query.
## $docQueries stores the matching work item query for each LiveDoc.
## Both lists use the same index so each document can find its own query later.
##
## $projectIds stores each represented project once for filter catalogs.
## ==========================================================================
#set ( $docItems = [] )
#set ( $docQueries = [] )
#set ( $docRevisions = [] )
#set ( $projectIds = [] )

#if ( $projectId )
    #set ( $void = $projectIds.add($projectId) )
#end

## ==========================================================================
## $widgetTableId gives this widget instance its own table element.
## ==========================================================================
#set ( $tableUniqueId = $widgetContext.generateUniqueElementId() )
#set ( $widgetTableId = "widget-table-${tableUniqueId}" )

## ==========================================================================
## This is the id used for the div that encloses the widget table.
## Used for styling the table. 
## ==========================================================================
#set ( $divId = $widgetContext.generateUniqueElementId() )

## ==========================================================================
## Collect LiveDocs and build one work item query per LiveDoc.
## The row-building step uses the collected documents and matching queries.
## ==========================================================================
#macro ( prepareRowsMacro )
    ## ======================================================================
    ## Execute the Data Set query through document search. This preserves the
    ## query path that rendered project-group scopes before Project Baseline
    ## was added, while still allowing a selected revision to be applied.
    ## ======================================================================
    #set ( $_docsSearch = $transaction.documents().search().query($documentQuery) )

    #if ( !$effectiveRevision.equals("") )
        #set ( $_docsSearch = $_docsSearch.baseline("$effectiveRevision") )
    #end

    #set ( $_docs = $_docsSearch.sort("project.id space.id title") )

    #foreach ( $_doc in $_docs )
        ## ==================================================================
        ## Skip unresolved documents because their fields and links cannot
        ## be rendered safely.
        ## ==================================================================
        #if ( !$_doc.isUnresolvable() )
            #set ( $rowProjectId = $_doc.fields().project().projectId() )
            #set ( $rowRevision = "$!effectiveRevision" )

            ## ==============================================================
            ## A valid project context is required for this document's work
            ## item query and portal links.
            ## ==============================================================
            #if ( $rowProjectId )
                #if ( !$projectIds.contains($rowProjectId) )
                    #set ( $void = $projectIds.add($rowProjectId) )
                #end

                #set ( $void = $docItems.add($_doc) )
                #set ( $void = $docRevisions.add($rowRevision) )

                ## ==========================================================
                ## Polarion stores the default space with an "_default/"
                ## prefix that is not part of document.id query values.
                ## ==========================================================
                #set ( $docNameWithSpace = $_doc.getOldApi().getRelativePath().replace("_default/","") )

                ## ==========================================================
                ## Build the work item query with the document's own project.
                ## Equal document paths in different projects therefore keep
                ## independent work item counts.
                ## ==========================================================
                #set ( $void = $docQueries.add("(project.id:$rowProjectId AND (NOT type:heading) AND document.id:$q$docNameWithSpace$q)") )
            #end
        #end
    #end
#end

## ==========================================================================
## Resolve configured document field metadata once for all later table stages.
## Filter behavior comes from Polarion field types rather than field ids:
##   - scalar enumerations use configured catalog values;
##   - date and date-time fields use the date-range control;
##   - multi-value, text, unknown, or cross-project conflicts use list search.
##
## A field may be undefined or configured differently in another project.
## The list fallback keeps one DataTables column behavior safe for every row.
## ==========================================================================
#macro ( prepareFieldMetadataMacro )
    #set ( $columnFieldIds = [] )
    #set ( $fieldTitlesMap = $objectFactory.newMap() )
    #set ( $fieldFilterTypesMap = $objectFactory.newMap() )
    #set ( $fieldProjectIdsMap = $objectFactory.newMap() )

    #foreach ( $fieldIdRaw in $parameters.columnFields.value().split(",") )
        #set ( $fieldId = $fieldIdRaw.trim() )

        #if ( !$fieldId.equals("") && !$columnFieldIds.contains($fieldId) )
            #set ( $void = $columnFieldIds.add($fieldId) )
            #set ( $fieldTitle = $fieldId )
            #set ( $resolvedFilterType = "" )
            #set ( $hasTypeConflict = false )
            #set ( $fieldProjectIds = [] )

            ## ==============================================================
            ## Inspect every represented document because custom field
            ## definitions can differ by project or document configuration.
            ## Undefined fields are ignored and render as empty cells later.
            ## ==============================================================
            #foreach ( $metadataDoc in $docItems )
                #set ( $renderingField = $metadataDoc.fields().get($fieldId) )

                #if ( $renderingField.is().defined() )
                    #if ( $fieldTitle.equals($fieldId) )
                        #set ( $fieldTitle = $renderingField.label() )
                    #end

                    #set ( $metadataProjectId = $metadataDoc.fields().project().projectId() )
                    #if ( $metadataProjectId && !$fieldProjectIds.contains($metadataProjectId) )
                        #set ( $void = $fieldProjectIds.add($metadataProjectId) )
                    #end

                    ## ======================================================
                    ## getFieldType() supports both built-in and custom
                    ## fields. Enumeration metadata is checked separately
                    ## because IEnumType does not expose primitive type names.
                    ## ======================================================
                    #set ( $oldApiDocument = $metadataDoc.getOldApi() )
                    #set ( $fieldType = $oldApiDocument.getFieldType($fieldId) )
                    #set ( $enumerationType = $oldApiDocument.getEnumerationTypeForField($fieldId) )
                    #set ( $candidateFilterType = "list" )

                    #if ( $enumerationType.isPresent() )
                        ## ==================================================
                        ## The catalog control compares one raw value per row.
                        ## Multi-enumerations remain list filters until the
                        ## client supports matching several catalog values.
                        ## ==================================================
                        #set ( $listItemType = "$!fieldType.getItemType()" )
                        #if ( $listItemType.equals("") )
                            #set ( $candidateFilterType = "catalog" )
                        #end
                    #else
                        #set ( $primitiveTypeName = "$!fieldType.getTypeName()" )
                        #if ( $primitiveTypeName.equals("java.util.Date") || $primitiveTypeName.equals("com.polarion.core.util.types.DateOnly") )
                            #set ( $candidateFilterType = "date" )
                        #end
                    #end

                    ## ======================================================
                    ## One table column can have only one filter control.
                    ## Prefer list search when projects disagree about the
                    ## same field id instead of applying invalid typed logic.
                    ## ======================================================
                    #if ( $resolvedFilterType.equals("") )
                        #set ( $resolvedFilterType = $candidateFilterType )
                    #elseif ( !$resolvedFilterType.equals($candidateFilterType) )
                        #set ( $hasTypeConflict = true )
                    #end
                #end
            #end

            #if ( $resolvedFilterType.equals("") || $hasTypeConflict )
                #set ( $resolvedFilterType = "list" )
            #end

            #set ( $void = $fieldTitlesMap.put($fieldId, $fieldTitle) )
            #set ( $void = $fieldFilterTypesMap.put($fieldId, $resolvedFilterType) )
            #set ( $void = $fieldProjectIdsMap.put($fieldId, $fieldProjectIds) )
        #end
    #end
#end

## ==========================================================================
## Merge project-level filter catalogs for all projects represented by the
## Data Set. Catalog values come from Polarion configuration rather than only
## the displayed rows, so valid values remain selectable when no row uses them.
## ==========================================================================
#macro ( prepareFilterOptionsMacro )
    #set ( $headerFilterOptionsMap = $objectFactory.newMap() )
    #set ( $projectFilterOptions = [] )
    #set ( $spaceFilterOptions = [] )
    #set ( $documentTypeFilterOptions = [] )
    #set ( $customFieldFilterOptionsMap = $objectFactory.newMap() )

    ## ======================================================================
    ## Allocate one merged option list for every configured scalar enum field.
    ## prepareFieldMetadataMacro has already removed multi-value and conflicting
    ## definitions from catalog-filter consideration.
    ## ======================================================================
    #foreach ( $fieldId in $columnFieldIds )
        #if ( $fieldFilterTypesMap.get($fieldId).equals("catalog") )
            #set ( $fieldOptions = [] )
            #set ( $void = $customFieldFilterOptionsMap.put($fieldId, $fieldOptions) )
        #end
    #end

    #foreach ( $catalogProjectId in $projectIds )
        #set ( $trackerProject = $trackerService.getTrackerProject($catalogProjectId) )

        #if ( $trackerProject )
            ## ==================================================================
            ## Project display names are the raw values stored on table rows.
            ## Deduplicate names because filter values are currently strings,
            ## not project-id/label pairs.
            ## ==================================================================
            #set ( $projectName = $trackerProject.getName() )
            #if ( !$projectFilterOptions.contains($projectName) )
                #set ( $void = $projectFilterOptions.add($projectName) )
            #end

            ## ==================================================================
            ## Merge all configured Spaces from this project. Equal Space labels
            ## intentionally form one filter choice that can match several
            ## projects.
            ## ==================================================================
            #set ( $projectSpaces = $transaction.spaces().getSpaces().project($catalogProjectId).path("") )
            #foreach ( $projectSpace in $projectSpaces )
                #set ( $spaceLabel = $projectSpace.label() )
                #if ( !$spaceFilterOptions.contains($spaceLabel) )
                    #set ( $void = $spaceFilterOptions.add($spaceLabel) )
                #end
            #end

            ## ==================================================================
            ## Document types and custom field enumerations are project-specific.
            ## Hidden options are omitted and equal display names are shown once.
            ## ==================================================================
            #foreach ( $documentType in $trackerProject.getModuleTypeEnum().getAllOptions() )
                #if ( !$documentType.isHidden() )
                    #set ( $documentTypeName = $documentType.getName() )
                    #if ( !$documentTypeFilterOptions.contains($documentTypeName) )
                        #set ( $void = $documentTypeFilterOptions.add($documentTypeName) )
                    #end
                #end
            #end

            #foreach ( $fieldId in $columnFieldIds )
                #if ( $fieldFilterTypesMap.get($fieldId).equals("catalog") )
                    #set ( $fieldProjectIds = $fieldProjectIdsMap.get($fieldId) )

                    ## ==========================================================
                    ## Query an enumeration only where a returned document proved
                    ## that the field is defined. This avoids requesting a custom
                    ## field configuration from unrelated projects.
                    ## ==========================================================
                    #if ( $fieldProjectIds.contains($catalogProjectId) )
                        #set ( $fieldEnumeration = $trackerService.getDataService().getEnumerationForKey("Module", $fieldId, $trackerProject.getContextId()) )

                        #if ( $fieldEnumeration )
                            #set ( $fieldOptions = $customFieldFilterOptionsMap.get($fieldId) )
                            #foreach ( $fieldOption in $fieldEnumeration.getAllOptions() )
                                #if ( !$fieldOption.isHidden() )
                                    #set ( $fieldOptionName = $fieldOption.getName() )
                                    #if ( !$fieldOptions.contains($fieldOptionName) )
                                        #set ( $void = $fieldOptions.add($fieldOptionName) )
                                    #end
                                #end
                            #end
                        #end
                    #end
                #end
            #end
        #end
    #end

    ## ======================================================================
    ## Publish completed catalogs only after every project has contributed.
    ## The shared DataTables macro reads these lists by header key.
    ## ======================================================================
    #set ( $void = $headerFilterOptionsMap.put("project", $projectFilterOptions) )
    #set ( $void = $headerFilterOptionsMap.put("space", $spaceFilterOptions) )
    #set ( $void = $headerFilterOptionsMap.put("documentHtml", $documentTypeFilterOptions) )

    #foreach ( $fieldId in $columnFieldIds )
        #if ( $customFieldFilterOptionsMap.containsKey($fieldId) )
            #set ( $void = $headerFilterOptionsMap.put($fieldId, $customFieldFilterOptionsMap.get($fieldId)) )
        #end
    #end
#end

## ==========================================================================
## Build the DataTables column definitions in Velocity maps.
## $headersKeys preserves display order because map iteration order is not used.
## ==========================================================================
#macro ( prepareHeadersMacro )
    ## ======================================================================
    ## This map stores the table columns.
    ## key = the id used by JavaScript/DataTables
    ## value = the text shown in the column header
    ## ======================================================================
    #set ( $headersMap = $objectFactory.newMap() )

    ## ======================================================================
    ## This map identifies the filter control for each displayed column.
    ## Catalog, date, list, and computed numeric columns use distinct controls.
    ## ======================================================================
    #set ( $headerFilterTypesMap = $objectFactory.newMap() )

    ## ======================================================================
    ## This map decides whether a column contributes to the global search.
    ## Displayed semantic columns use clean values prepared with their metadata.
    ## Computed columns retain their dedicated numeric filter controls instead.
    ## ======================================================================
    #set ( $headerGlobalSearchMap = $objectFactory.newMap() )

    ## ======================================================================
    ## Used to track the order of columns when rendering, since map is unordered.
    ## ======================================================================
    #set ( $headersKeys = [] )

    #if ( true == $parameters.showProject.value() )
        #set ( $void = $headersMap.put("project", "Project") )
        #set ( $void = $headerFilterTypesMap.put("project", "catalog") )
        #set ( $void = $headerGlobalSearchMap.put("project", true) )
        #set ( $void = $headersKeys.add("project") )
    #end

    #if ( true == $parameters.showSpace.value() )
        #set ( $void = $headersMap.put("space", "Space") )
        #set ( $void = $headerFilterTypesMap.put("space", "catalog") )
        #set ( $void = $headerGlobalSearchMap.put("space", true) )
        #set ( $void = $headersKeys.add("space") )
    #end

    #set ( $void = $headersMap.put("documentHtml", "Document") )
    #set ( $void = $headerFilterTypesMap.put("documentHtml", "catalog") )
    #set ( $void = $headerGlobalSearchMap.put("documentHtml", true) )
    #set ( $void = $headersKeys.add("documentHtml") )

    ## ======================================================================
    ## Custom document columns use metadata prepared from every represented
    ## project. The user-facing label remains separate from the field type that
    ## selects the appropriate DataTables filter control.
    ## ======================================================================
    #foreach ( $fieldId in $columnFieldIds )
        #set ( $void = $headersMap.put($fieldId, $fieldTitlesMap.get($fieldId)) )
        #set ( $void = $headerFilterTypesMap.put($fieldId, $fieldFilterTypesMap.get($fieldId)) )
        #set ( $void = $headerGlobalSearchMap.put($fieldId, true) )
        #set ( $void = $headersKeys.add($fieldId) )
    #end

    #if ( true == $parameters.showSignaturesStatus.value() )
        #set ( $void = $headersMap.put("signatureHtml","Signatures") )
        #set ( $void = $headerFilterTypesMap.put("signatureHtml", "list") )
        #set ( $void = $headerGlobalSearchMap.put("signatureHtml", true) )
        #set ( $void = $headersKeys.add("signatureHtml") )
    #end

    ## ======================================================================
    ## This is for user-defined query-count columns in the matrix.
    ## Lets user create columns with defined queries from Lucene
    ## ======================================================================
    #foreach ( $columnParam in $parameters.columns.get() )
        #if ( !($columnParam.title.value() == "") && !($columnParam.query.value() == "") )
            #set ( $void = $headersMap.put($columnParam.title.value(), $columnParam.title.value()) )
            #set ( $void = $headerFilterTypesMap.put($columnParam.title.value(), "number") )
            #set ( $void = $headerGlobalSearchMap.put($columnParam.title.value(), false) )
            #set ( $void = $headersKeys.add($columnParam.title.value()) )
        #end
    #end
#end

## ==========================================================================
## Fetching data using Velocity maps, then passing
## those maps to Javascript for DataTables.
## ==========================================================================
#macro ( prepareDataRowsMacro )
    ## ======================================================================
    ## $dataRows stores all table rows.
    ## Each $rowsMap inside it stores one table row.
    ## ======================================================================
    #set ( $dataRows = [] )

    ## ======================================================================
    ## Create one row map for each document.
    ## ======================================================================
    #foreach ( $docu in $docItems )
        #set ( $indexLoop = $velocityCount - 1 )
        #set ( $docQuery = $docQueries.get($indexLoop) )
        #set ( $rowRevision = $docRevisions.get($indexLoop) )
        #set ( $rowProjectId = $docu.fields().project().projectId() )

        ## ==================================================================
        ## This map stores all cells for the current row.
        ## key = column id, value = rendered cell content.
        ## ==================================================================
        #set ( $rowsMap = $objectFactory.newMap() )

        #set ( $spaceHtml = "" )
        #set ( $projectHtml = "" )
        #set ( $signatureHtml = "" )

        ## ==================================================================
        ## Add the Project cell when the Project column is enabled.
        ## ==================================================================
        #if ( true == $parameters.showProject.value() )
            #set ( $projectHtml = "$!docu.fields().project().render()")
            #set ( $void = $rowsMap.put("project", $projectHtml) )
            #set ( $void = $rowsMap.put("__tsbFilterValue_project", $docu.getOldApi().getProject().getName()) )
            #set ( $void = $rowsMap.put("__tsbSearchValue_project", $docu.getOldApi().getProject().getName()) )
        #end

        ## ==================================================================
        ## Add the Space cell when the Space column is enabled.
        ## ==================================================================
        #if ( true == $parameters.showSpace.value() )
            #set ( $spaceHtml = "$!docu.space().render()" )
            #set ( $void = $rowsMap.put("space", $spaceHtml) )
            #set ( $void = $rowsMap.put("__tsbFilterValue_space", $docu.space().label()) )
            #set ( $void = $rowsMap.put("__tsbSearchValue_space", $docu.space().label()) )
        #end

        ## ==================================================================
        ## Add the Document cell. Display keeps Polarion-rendered link HTML,
        ## while global search receives only the document's plain title.
        ## ==================================================================
        #set ( $documentHtml = $docu.render().withIcon().withLinks(true) )
        #set ( $void = $rowsMap.put("documentHtml", $documentHtml) )
        #set ( $void = $rowsMap.put("__tsbFilterValue_documentHtml", $docu.getOldApi().getType().getName()) )
        #set ( $void = $rowsMap.put("__tsbSearchValue_documentHtml", $docu.getOldApi().getTitle()) )

        ## ==================================================================
        ## Add the Signatures cell when enabled.
        ## Only active signature states are shown.
        ## ==================================================================
        #if ( true == $parameters.showSignaturesStatus.value() )
            #set ( $workflowSignatures = $docu.fields().workflowSignatures().toArrayList )
            
            #foreach( $row in $workflowSignatures )
                #set ( $signatureStatus = $row.fields().signatureState().optionId() )
                #if ( !($signatureStatus.equals("obsolete")) && !($signatureStatus.equals("notAvailable")) )
					#set ($sigsHtml = "<b>$row.fields().signatureState().render().withIcon(false) - $row.label()</b><br>")
					#set ($signatureHtml = "${signatureHtml}<br>${sigsHtml}" )
					
					#foreach($s in $row.fields().signatures().toArrayList())
						#set ($renderedSig = "<b>$s.fields().signedBy().render()</b> - $s.fields().verdict().render().withIcon(false) - $s.fields().verdictTime().render()")
						#set ($signatureHtml = "${signatureHtml}<br>${renderedSig}" )
					#end
                #end
            #end

            #set ( $void = $rowsMap.put("signatureHtml", $signatureHtml) )
        #end

        ## ==================================================================
        ## Add one cell for each configured document field id. Visible cells
        ## keep Polarion-rendered HTML while typed filters and global search
        ## receive separate semantic values when the resolved type provides
        ## a stable scalar representation.
        ## ==================================================================
        #foreach ( $fieldId in $columnFieldIds )
            #set ( $documentField = $docu.fields().get($fieldId) )
            #set ( $fieldHtml = "$!documentField.render()" )
            #set ( $void = $rowsMap.put($fieldId, $fieldHtml) )
            #set ( $fieldFilterType = $fieldFilterTypesMap.get($fieldId) )
            #set ( $filterValueKey = "__tsbFilterValue_${fieldId}" )
            #set ( $searchValueKey = "__tsbSearchValue_${fieldId}" )

            ## ==============================================================
            ## Scalar enum fields expose one display name that matches the
            ## merged catalog values prepared from project configuration.
            ## ==============================================================
            #if ( $fieldFilterType.equals("catalog") )
                #set ( $oldFieldValue = $docu.getOldApi().getValue($fieldId) )
                #set ( $rawFilterValue = "$!oldFieldValue.getName()" )
                #set ( $void = $rowsMap.put($filterValueKey, $rawFilterValue) )
                #set ( $void = $rowsMap.put($searchValueKey, $rawFilterValue) )

            ## ==============================================================
            ## Date and DateOnly values have different old-API representations.
            ## Normalize both to yyyy-MM-dd for DataTables sorting and range
            ## comparisons without changing their rendered cell content.
            ## ==============================================================
            #elseif ( $fieldFilterType.equals("date") )
                #set ( $oldApiDocument = $docu.getOldApi() )
                #set ( $oldFieldValue = $oldApiDocument.getValue($fieldId) )
                #set ( $rowFieldType = $oldApiDocument.getFieldType($fieldId) )
                #set ( $rowFieldTypeName = "$!rowFieldType.getTypeName()" )
                #set ( $rawFilterValue = "" )

                #if ( $oldFieldValue )
                    #if ( $rowFieldTypeName.equals("java.util.Date") )
                        #set ( $rawFilterValue = $date.format("yyyy-MM-dd", $oldFieldValue) )
                    #elseif ( $rowFieldTypeName.equals("com.polarion.core.util.types.DateOnly") )
                        #set ( $rawFilterValue = $date.format("yyyy-MM-dd", $oldFieldValue.getDate()) )
                    #end
                #end

                #set ( $void = $rowsMap.put($filterValueKey, $rawFilterValue) )
                #set ( $void = $rowsMap.put($searchValueKey, $rawFilterValue) )
            #end
        #end
        
        ## ==================================================================
        ## This is for user-defined query-count columns in the matrix.
        ## Lets user create columns with defined queries from Lucene
        ## ==================================================================
        #foreach ( $columnParam in $parameters.columns.get() )
            #if ( !($columnParam.title.value() == "") && !($columnParam.query.value() == "") )
                ## ==========================================================
                ## Count matching work items and build links to the tracker
                ## result and filtered document view.
                ## Zero counts receive a dedicated CSS class.
                ## The class applies only to additional-column count links.
                ## ==========================================================
                #set ( $cellQuery = "$docQuery AND ($columnParam.query.value())" )
                #set ( $workitemSearch = $transaction.workItems().search().query("$cellQuery") )
                #if ( !$rowRevision.equals("") )
                    #set ( $workitemSearch = $workitemSearch.baseline("$rowRevision") )
                #end
