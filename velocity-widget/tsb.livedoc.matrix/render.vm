#import("tsb.framework.vm")

## ==========================================================================
## Warning shown when the Data Set does not resolve to one project.
## This widget builds document and work item links in one project context.
## ==========================================================================
#set ( $warnSingleProject = "This widget renders a document matrix for <b>single Projects only</b>. Please select a <b>single Project</b> for the <b>Scope parameter</b>." )

## ==========================================================================
## Read the selected project and document query from the Data Set parameter.
## $allowRendering is turned off when the required project scope is missing.
## ==========================================================================
#set ( $allowRendering = true )
#set ( $projectId = $parameters.dataSet.scope().projectId() )
#set ( $documentQuery = $parameters.dataSet.getFor().revision("").queryToShow() )

## ==========================================================================
## Stop rendering early when the Data Set does not select a single project.
## ==========================================================================
#if ( !$projectId )
    $widgetContext.renderWarning("$warnSingleProject")
    #set ( $allowRendering = false )
#end

## ==========================================================================
## $docItems stores the LiveDocs found by the document query.
## $docQueries stores the matching work item query for each LiveDoc.
## Both lists use the same index so each document can find its own query later.
## ==========================================================================
#set ( $docItems = [] )
#set ( $docQueries = [] )

## ==========================================================================
## $q keeps double quotes readable when building Lucene query strings.
## 
## $widgetTableId gives this widget instance its own table element.
## ==========================================================================
#set ( $q = '"' )
#set ( $tableUniqueId = $widgetContext.generateUniqueElementId() )
#set ( $widgetTableId = "widget-table-${tableUniqueId}" )

## ==========================================================================
## This is the id used for the div that encloses the widget table.
## Used for styling the table. 
## ==========================================================================
#set ( $divId = $widgetContext.generateUniqueElementId() )

## ==========================================================================
## Collect LiveDocs and build one work item query per LiveDoc.
## The row-building step uses the collected documents and matching queries.
## ==========================================================================
#macro ( prepareRowsMacro )
    ## ======================================================================
    ## Get the documents selected by the widget parameter.
    ## Sort them by project, space, and title.
    ## ======================================================================
    #set ( $_docs = $transaction.documents().search().query($documentQuery).sort("project.id space.id title") )

    #foreach ( $_doc in $_docs )
        ## ==================================================================
        ## Skip unresolved documents because their fields and links cannot be
        ## rendered safely. Resolved documents become table rows.
        ## ==================================================================
        #if (!$_doc.isUnresolvable())
            #set ( $void = $docItems.add($_doc) )

            ## ==============================================================
            ## Get the document id used by work item document queries.
            ## Polarion stores the default space with an "_default/" prefix.
            ## ==============================================================
            #set ( $docNameWithSpace = $_doc.getOldApi().getRelativePath().replace("_default/","") )

            ## ==============================================================
            ## Build a work item query for this document.
            ## It finds non-heading work items inside this document.
            ## ==============================================================
            #set ( $void = $docQueries.add("(project.id:$_doc.fields().project().projectId() AND (NOT type:heading) AND document.id:$q$docNameWithSpace$q)") )
        #end
    #end
#end

## ==========================================================================
## Build project-level filter catalogs independently from the displayed rows.
## This keeps supported values visible even when the current query has no
## document for a configured Space, Document Type, or Document Status.
## ==========================================================================
#macro ( prepareFilterOptionsMacro )
    #set ( $headerFilterOptionsMap = $objectFactory.newMap() )
    #set ( $trackerProject = $trackerService.getTrackerProject($projectId) )

    ## ======================================================================
    ## The current widget supports one project, but Project uses the same
    ## catalog structure needed by the planned multi-project implementation.
    ## ======================================================================
    #set ( $projectFilterOptions = [] )
    #set ( $void = $projectFilterOptions.add($trackerProject.getName()) )
    #set ( $void = $headerFilterOptionsMap.put("project", $projectFilterOptions) )

    ## ======================================================================
    ## Read all visible Spaces from Polarion instead of deriving them from
    ## the current document rows. Empty Spaces remain available for filtering.
    ## ======================================================================
    #set ( $spaceFilterOptions = [] )
    #set ( $projectSpaces = $transaction.spaces().getSpaces().project($projectId).path("") )
    #foreach ( $projectSpace in $projectSpaces )
        #set ( $void = $spaceFilterOptions.add($projectSpace.label()) )
    #end
    #set ( $void = $headerFilterOptionsMap.put("space", $spaceFilterOptions) )

    ## ======================================================================
    ## Read configured Document Types and Document Statuses from Polarion.
    ## Hidden options are omitted, and repeated display names are added once.
    ## Polarion can return context-specific options with the same display name.
    ## ======================================================================
    #set ( $documentTypeFilterOptions = [] )
    #foreach ( $documentType in $trackerProject.getModuleTypeEnum().getAllOptions() )
        #if ( !$documentType.isHidden() )
            #set ( $documentTypeName = $documentType.getName() )
            #if ( !$documentTypeFilterOptions.contains($documentTypeName) )
                #set ( $void = $documentTypeFilterOptions.add($documentTypeName) )
            #end
        #end
    #end
    #set ( $void = $headerFilterOptionsMap.put("documentHtml", $documentTypeFilterOptions) )

    #set ( $documentStatusFilterOptions = [] )
    #set ( $documentStatusEnum = $trackerService.getDataService().getEnumerationForKey("Module", "status", $trackerProject.getContextId()) )
    #foreach ( $documentStatus in $documentStatusEnum.getAllOptions() )
        #if ( !$documentStatus.isHidden() )
            #set ( $documentStatusName = $documentStatus.getName() )
            #if ( !$documentStatusFilterOptions.contains($documentStatusName) )
                #set ( $void = $documentStatusFilterOptions.add($documentStatusName) )
            #end
        #end
    #end
    #set ( $void = $headerFilterOptionsMap.put("status", $documentStatusFilterOptions) )
#end

## ==========================================================================
## Build the DataTables column definitions in Velocity maps.
## $headersKeys preserves display order because map iteration order is not used.
## ==========================================================================
#macro ( prepareHeadersMacro )
    ## ======================================================================
    ## This map stores the table columns.
    ## key = the id used by JavaScript/DataTables
    ## value = the text shown in the column header
    ## ======================================================================
    #set ( $headersMap = $objectFactory.newMap() )

    ## ======================================================================
    ## This map identifies the filter control for each displayed column.
    ## Catalog, date, list, and computed numeric columns use distinct controls.
    ## ======================================================================
    #set ( $headerFilterTypesMap = $objectFactory.newMap() )

    ## ======================================================================
    ## Used to track the order of columns when rendering, since map is unordered.
    ## ======================================================================
    #set ( $headersKeys = [] )

    #if ( true == $parameters.showProject.value() )
        #set ( $void = $headersMap.put("project", "Project") )
        #set ( $void = $headerFilterTypesMap.put("project", "catalog") )
        #set ( $void = $headersKeys.add("project") )
    #end

    #if ( true == $parameters.showSpace.value() )
        #set ( $void = $headersMap.put("space", "Space") )
        #set ( $void = $headerFilterTypesMap.put("space", "catalog") )
        #set ( $void = $headersKeys.add("space") )
    #end

    #set ( $void = $headersMap.put("documentHtml", "Document") )
    #set ( $void = $headerFilterTypesMap.put("documentHtml", "catalog") )
    #set ( $void = $headersKeys.add("documentHtml") )

    ## ======================================================================
    ## Custom columns from the widget parameter.
    ## Example: "status,severity" becomes two table columns.
    ## ======================================================================
    ###set ( $firstDoc = "" )
    ###set ( $firstDoc = $docItems.get(0) )

    #foreach ( $fieldIdRaw in $parameters.columnFields.value().split(",") )
        #set ( $fieldId = $fieldIdRaw.trim() )

        #if ( !$fieldId.equals("") )
            #if ( $docItems.size() > 0 )
                #set ( $fieldTitle = "$!docItems.get(0).fields().get($fieldId).label()" )
            #else
                #set ( $fieldTitle = $fieldId )
            #end

            #set ( $void = $headersMap.put($fieldId, $fieldTitle) )
            #if ( $fieldId.equals("status") )
                #set ( $void = $headerFilterTypesMap.put($fieldId, "catalog") )
            #elseif ( $fieldId.equals("updated") )
                #set ( $void = $headerFilterTypesMap.put($fieldId, "date") )
            #else
                #set ( $void = $headerFilterTypesMap.put($fieldId, "list") )
            #end
            #set ( $void = $headersKeys.add($fieldId) )
        #end
    #end

    #if ( true == $parameters.showSignaturesStatus.value() )
        #set ( $void = $headersMap.put("signatureHtml","Signatures") )
        #set ( $void = $headerFilterTypesMap.put("signatureHtml", "list") )
        #set ( $void = $headersKeys.add("signatureHtml") )
    #end

    ## ======================================================================
    ## This is for user-defined query-count columns in the matrix.
    ## Lets user create columns with defined queries from Lucene
    ## ======================================================================
    #foreach ( $columnParam in $parameters.columns.get() )
        #if ( !($columnParam.title.value() == "") && !($columnParam.query.value() == "") )
            #set ( $void = $headersMap.put($columnParam.title.value(), $columnParam.title.value()) )
            #set ( $void = $headerFilterTypesMap.put($columnParam.title.value(), "number") )
            #set ( $void = $headersKeys.add($columnParam.title.value()) )
        #end
    #end
#end

## ==========================================================================
## Fetching data using Velocity maps, then passing
## those maps to Javascript for DataTables.
## ==========================================================================
#macro ( prepareDataRowsMacro )
    ## ======================================================================
    ## $dataRows stores all table rows.
    ## Each $rowsMap inside it stores one table row.
    ## ======================================================================
    #set ( $dataRows = [] )

    ## ======================================================================
    ## Create one row map for each document.
    ## ======================================================================
    #foreach ( $docu in $docItems )
        #set ( $indexLoop = $velocityCount - 1 )
        #set ( $docQuery = $docQueries.get($indexLoop) )

        ## ==================================================================
        ## This map stores all cells for the current row.
        ## key = column id, value = rendered cell content.
        ## ==================================================================
        #set ( $rowsMap = $objectFactory.newMap() )

        #set ( $spaceHtml = "" )
        #set ( $projectHtml = "" )
        #set ( $signatureHtml = "" )

        ## ==================================================================
        ## Add the Project cell when the Project column is enabled.
        ## ==================================================================
        #if ( true == $parameters.showProject.value() )
            #set ( $projectHtml = "$!docu.fields().project().render()")
            #set ( $void = $rowsMap.put("project", $projectHtml) )
            #set ( $void = $rowsMap.put("__tsbFilterValue_project", $docu.getOldApi().getProject().getName()) )
        #end

        ## ==================================================================
        ## Add the Space cell when the Space column is enabled.
        ## ==================================================================
        #if ( true == $parameters.showSpace.value() )
            #set ( $spaceHtml = "$!docu.space().render()" )
            #set ( $void = $rowsMap.put("space", $spaceHtml) )
            #set ( $void = $rowsMap.put("__tsbFilterValue_space", $docu.space().label()) )
        #end

        ## ==================================================================
        ## Add the Document cell. This contains Polarion-rendered link HTML.
        ## ==================================================================
        #set ( $documentHtml = $docu.render().withIcon().withLinks(true) )
        #set ( $void = $rowsMap.put("documentHtml", $documentHtml) )
        #set ( $void = $rowsMap.put("__tsbFilterValue_documentHtml", $docu.getOldApi().getType().getName()) )

        ## ==================================================================
        ## Add the Signatures cell when enabled.
        ## Only active signature states are shown.
        ## ==================================================================
        #if ( true == $parameters.showSignaturesStatus.value() )
            #set ( $workflowSignatures = $docu.fields().workflowSignatures().toArrayList )
            
            #foreach( $row in $workflowSignatures )
                #set ( $signatureStatus = $row.fields().signatureState().optionId() )
                #if ( !($signatureStatus.equals("obsolete")) && !($signatureStatus.equals("notAvailable")) )
					#set ($sigsHtml = "<b>$row.fields().signatureState().render().withIcon(false) - $row.label()</b><br>")
					#set ($signatureHtml = "${signatureHtml}<br>${sigsHtml}" )
					
					#foreach($s in $row.fields().signatures().toArrayList())
						#set ($renderedSig = "<b>$s.fields().signedBy().render()</b> - $s.fields().verdict().render().withIcon(false) - $s.fields().verdictTime().render()")
						#set ($signatureHtml = "${signatureHtml}<br>${renderedSig}" )
					#end
                #end
            #end

            #set ( $void = $rowsMap.put("signatureHtml", $signatureHtml) )
        #end

        ## ==================================================================
        ## Add one cell for each configured document field id.
        ## ==================================================================
        #set ( $fieldsId = $parameters.columnFields.value().split(",") )
        #foreach ( $fieldIdRaw in $fieldsId )
            #set ( $fieldId = $fieldIdRaw.trim() )
            #if ( !$fieldId.equals("") )
                #set ( $fieldHtml = "$!docu.fields().get($fieldId).render()" )
                #set ( $void = $rowsMap.put($fieldId, $fieldHtml) )

                ## ==========================================================
                ## Status and Updated use raw values for smart filtering.
                ## Their rendered HTML remains unchanged in the visible cell.
                ## ==========================================================
                #if ( $fieldId.equals("status") )
                    #set ( $void = $rowsMap.put("__tsbFilterValue_status", $docu.getOldApi().getStatus().getName()) )
                #elseif ( $fieldId.equals("updated") )
                    #set ( $updatedDate = $date.format("yyyy-MM-dd", $docu.getOldApi().getUpdated()) )
                    #set ( $void = $rowsMap.put("__tsbFilterValue_updated", $updatedDate) )
                #end
            #end
        #end
        
        ## ==================================================================
        ## This is for user-defined query-count columns in the matrix.
        ## Lets user create columns with defined queries from Lucene
        ## ==================================================================
        #foreach ( $columnParam in $parameters.columns.get() )
            #if ( !($columnParam.title.value() == "") && !($columnParam.query.value() == "") )
                ## ==========================================================
                ## Count matching work items and build links to the tracker
                ## result and filtered document view.
                ## Zero counts receive a dedicated CSS class.
                ## The class applies only to additional-column count links.
                ## ==========================================================
                #set ( $cellQuery = "$docQuery AND ($columnParam.query.value())" )
                #set ( $workitemCount = $transaction.workItems().search().query("$cellQuery").size() )
                #set ( $trackerLink = $transaction.context().createPortalLink().project("$docu.fields().project().projectId()").workItems().query("$cellQuery").toEncodedRelativeUrl() )
                #set ( $docSpace = $docu.getOldApi().getModuleFolder() )
                #set ( $docName = $docu.fields().moduleName().get() )
                #set ( $docLink = $transaction.context().createPortalLink().project("$docu.fields().project().projectId()").document("$docSpace","$docName").filter("$cellQuery").toEncodedRelativeUrl() )

                #set ( $countClassAttribute = "" )
                #if ( $workitemCount == 0 )
                    #set ( $countClassAttribute = " class=${q}tsb-additional-column-zero${q}" )
                #end

                #set ( $countHtml = "<a$countClassAttribute href=$q$trackerLink$q>$workitemCount</a>" )
                #set ( $documentLinkHtml = "<a href=$q$docLink$q>Doc</a>" )
                #set ( $cellHtml = "$countHtml / $documentLinkHtml" )
                #set ( $void = $rowsMap.put($columnParam.title.value(), $cellHtml) )

                ## ==========================================================
                ## Keep the raw count separate from the rendered links.
                ## DataTables uses this value for numeric filtering.
                ## ==========================================================
                #set ( $filterValueKey = "__tsbFilterValue_${columnParam.title.value()}" )
                #set ( $void = $rowsMap.put($filterValueKey, $workitemCount) )
            #end
        #end

        ## ==================================================================
        ## The row is complete.
        ## Add it to the list of all rows.
        ## ==================================================================
        #set ( $void = $dataRows.add($rowsMap) )
    #end
#end

## ==========================================================================
