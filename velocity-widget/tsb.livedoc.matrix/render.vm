## ===========================================================================
## Collect LiveDocs and build one work item query per LiveDoc.
## The row-building step uses the collected documents and matching queries.
## ===========================================================================
#macro ( collectCollectionDocumentsMacro $collection )
    #if ( $collection && !$collection.isUnresolvable() )
        #set ( $collectionReference = $collection.getReference() )
        #set ( $collectionKey = "$!collectionReference.toPath()" )

        #if ( !$collectionKey.equals("") && !$processedCollectionKeys.contains($collectionKey) )
            #set ( $void = $processedCollectionKeys.add($collectionKey) )

            ## ===============================================================
            ## Collection elements are stored as document objects. Keep a key
            ## based on project and document path so duplicates are removed
            ## without mixing documents from different projects.
            ## ===============================================================
            #foreach ( $collectionElement in $collection.fields().elements() )
                #set ( $collectionObject = $collectionElement.fields().object().get() )

                ## ===========================================================
                ## Collection object references can point to documents outside
                ## the user's readable scope. Skip them before reading project,
                ## path, or revision metadata.
                ## ===========================================================
                #if ( $collectionObject && !$collectionObject.isUnresolvable() && $collectionObject.can().read() )
                    #set ( $collectionProjectId = $collectionObject.fields().project().projectId() )

                    #if ( $collectionProjectId )
                        #set ( $collectionDocumentPath = $collectionObject.getOldApi().getRelativePath().replace("_default/","") )
                        #set ( $collectionDocumentKey = "$collectionProjectId|$collectionDocumentPath" )

                        ## ===================================================
                        ## The selected Collection is visited before inherited
                        ## Collections. Keep the first occurrence so an upstream
                        ## duplicate cannot replace the selected revision.
                        ## ===================================================
                        #if ( !$collectionDocumentKeys.contains($collectionDocumentKey) )
                            #set ( $void = $collectionDocumentKeys.add($collectionDocumentKey) )
                            #set ( $void = $collectionDocumentMap.put($collectionDocumentKey, $collectionObject) )
                            #set ( $collectionElementRevision = "$!collectionElement.fields().revision().get()" )
                            #set ( $void = $collectionDocumentRevisionsMap.put($collectionDocumentKey, $collectionElementRevision) )
                        #end
                    #end
                #end
            #end

            #if ( $dataSetCollectionInheritanceEnabled )
                ## ===========================================================
                ## Inheritance follows direct upstream Collections recursively.
                ## processedCollectionKeys prevents cycles from repeating rows.
                ## ===========================================================
                #foreach ( $upstreamCollection in $collection.fields().upstreamCollections() )
                    #collectCollectionDocumentsMacro($upstreamCollection)
                #end
            #end
        #end
    #end
#end

