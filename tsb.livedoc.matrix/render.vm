#set($warnSingleProject = "This widget provides workitem count for <b>single Projects only</b>. Please select a <b>single Project</b> for the <b>Scope parameter</b>.") 
 
 
## ========================================================================== 
## Initialize and validate parameters 
## ========================================================================== 
#set ($allowRendering = true) 
#set ($projectId = $parameters.dataSet.scope().projectId()) 
#set ($docsQuery = $parameters.dataSet.getFor().revision("").queryToShow()) 
 
#if (!$projectId) 
	$widgetContext.renderWarning("$warnSingleProject") 
	#set ($allowRendering = false) 
#end 
 
#set($columnTitles = [])  
#set($columnQueries = [])  

#macro (prepareColumns) 
	#foreach ($columnParam in $parameters.columns.get()) 
		#if ( !($columnParam.title.value() == "") && !($columnParam.query.value() == "") ) 
			#set ($void = $columnTitles.add($columnParam.title.value())) 
			#set ($void = $columnQueries.add($columnParam.query.value())) 
		#end 
	#end 
#end 
 
#set($rowTitles = [])  
#set($rowQueries = [])  

#macro (prepareRows) 
	#set ($q = '"') 
	#set ($docs = $transaction.documents().search().query($docsQuery).sort("project.id space.id title")) 
 
	#foreach ($doc in $docs) 
		#set ($void = $rowTitles.add($doc)) 
		#set ($docNameWithSpace = $doc.getOldApi().getRelativePath().replace("_default/","")) 
		#set ($void = $rowQueries.add("(project.id:$projectId AND (NOT type:heading) AND document.id:$q$docNameWithSpace$q)")) 
	#end 
#end 
 
 
#macro(renderTableStart) 
	<table class="polarion-Document-table" style="margin: auto;empty-cells: show;border-collapse: collapse;width: 100%;border: 1px solid #CCCCCC;" id="polarion_wiki macro name=table;params=uid=client2"> 
	<tbody> 
#end 
 
#macro(renderTableEnd) 
	</tbody> 
	</table> 
#end 
 
#macro(renderTableHeader) 
	<tr> 
		#if ($parameters.showProject.value() == true) 
			<th style='text-align: left;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px; background-color: #d3d3d3;min-width:120px;'>Project</th> 
		#end 
 
		#if ($parameters.showSpace.value() == true) 
			<th style='text-align: left;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px; background-color: #d3d3d3;min-width:150px;'>Space</th> 
		#end 
 
		<th style='text-align: left;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px;background-color: #d3d3d3;'>Document</th> 
 
		## ========================================================================== 
		## Add column fields titles 
		## ========================================================================== 
		## split the fields 
		#set($fieldsId = $parameters.columnFields.value().split(","))  
 
		## get the first document in the list  
		#set ($firstDoc = "") 
		#if (!($rowTitles.size() == 0)) 
			#set ($firstDoc = $rowTitles.get(0)) 
		#end  
 
 
		## render field label 
		#foreach ($f in $fieldsId) 
			#set ($fieldTitle = "") 
			#if ($firstDoc == "") 
				#set ($fieldTitle = $f) 
			#else 
				#set ($fieldTitle = $!firstDoc.fields().get($f).label()) 
			#end 
 
			<th style='text-align: center;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px; background-color: #d3d3d3;'>$fieldTitle</th> 
		#end 
 
		## ========================================================================== 
		## Add signature column 
		## ========================================================================== 
		#if ($parameters.showSignaturesStatus.value() == true) 
			<th style='text-align: center;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px; background-color: #d3d3d3;'>Signatures</th> 
		#end 
 
		## ========================================================================== 
		## ToDo: Add unresolved comments title 
		## ========================================================================== 
 
		#foreach ($t in $columnTitles) 
			<th style='text-align: center;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px; background-color: #d3d3d3;'>$t</th> 
		#end 
	</tr> 
#end 
 
#macro(renderTableRows) 
	#foreach ($rowTitle in $rowTitles) 
		#set ($indexLoop = $velocityCount - 1) 
		#set ($rowQuery = "$rowQueries.get($indexLoop)") 
		#set ($workitemCount= $transaction.workItems().count().query("$rowQuery").result()) 
 
	<tr> 
 		#if ($parameters.showProject.value() == true) 
			<td style='text-align: left;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px;font-size: 11px;'>$rowTitle.fields().project().render()</td> 
		#end 
 
		#if ($parameters.showSpace.value() == true) 
			<td style='text-align: left;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px;font-size: 11px;'>$rowTitle.space().render()</td> 
		#end 
 
		<td style='text-align: left;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px;font-size: 11px;'>$rowTitle.render().withIcon().withLinks(true)</td> 
 
		## ========================================================================== 
		## Add column fields 
		## ========================================================================== 
		## split the fields 
		#set($fieldsId = $parameters.columnFields.value().split(","))  
 
		## render field label 
		#foreach ($f in $fieldsId) 
			<td style='text-align: center;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px;font-size: 11px;'> 
			$!rowTitle.fields().get($f).render() 
			</td> 
		#end 
 
## ========================================================================== 
## Add signature column 
## ========================================================================== 
#if ($parameters.showSignaturesStatus.value() == true) 
<td style='text-align: left;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px;font-size: 11px;'> 
#foreach($c in $rowTitle.fields().workflowSignatures())  
#if(!$c.fields().signatureState().optionId().equals("obsolete") && !$c.fields().signatureState().optionId().equals("notAvailable")) 
<span style="margin: 1px;">$c.render().htmlFor().forFrame().replace(", ", "")</span> 
#end 
#end 
</td> 
#end 
 
## ========================================================================== 
## ToDo: Add unresolved comments 
## ========================================================================== 
 
 
#foreach($columnQuery in $columnQueries) 
#set($cellQuery = "$rowQuery AND ($columnQuery)") 
 
<td style='text-align: center;vertical-align: top;height: 10px;border: 1px solid #CCCCCC;padding: 3px;font-size: 11px;'> 
#set($workitemCount= $transaction.workItems().count().query("$cellQuery").result()) 
#set($link = $transaction.context().createPortalLink().project("$projectId").workItems().query("$cellQuery").toEncodedRelativeUrl()) 
#set($docSpace = $rowTitle.getOldApi().getModuleFolder()) 
#set($docName = $rowTitle.fields().moduleName().get()) 
#set($docLink = $transaction.context().createPortalLink().project("$projectId").document("$docSpace","$docName").filter("$cellQuery").toEncodedRelativeUrl()) 
<a href="$link">$workitemCount</a> / <a href="$docLink">Doc</a>  
</td> 
#end 
</tr> 
#end 
#end 
 
## ========================================================================== 
## Main Code starts here 
## ========================================================================== 
#if ($allowRendering == true) 
#set ($contextId = $projectService.getProject($projectId).getContextId())  
#prepareColumns() 
#prepareRows() 
 
#renderTableStart() 
#renderTableHeader() 
#renderTableRows() 
#renderTableEnd() 
#end 
