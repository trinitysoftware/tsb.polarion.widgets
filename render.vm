## ==========================================================================
## OVERVIEW — tsb.livedoc.meta.v1 — render.vm
##
## Document list: title, document status (Draft/Published), last editor, last updated.
## ==========================================================================

#set ( $warnSingleProject = "Select a <b>single project</b> in the Data Set scope." )
#set ( $warnNoQuery = "Set a <b>Data Set</b> query (e.g. <code>*</code> or <code>space:Requirements</code>)." )

#set ( $allowRendering = true )
#set ( $projectId = $parameters.dataSet.scope().projectId() )
#set ( $docsQuery = $parameters.dataSet.getFor().revision("").queryToShow() )
#set ( $sortByLastUpdated = $parameters.sortByLastUpdated.value() )
#set ( $showSpaceColumn = $parameters.showSpaceColumn.value() )

#set ( $editorFieldIds = ["updatedBy", "author", "modifiedBy"] )
#set ( $updatedFieldId = "updated" )

## ==========================================================================
## Warnings
## ==========================================================================

#if ( !$projectId )
	$widgetContext.renderWarning("$warnSingleProject")
	#set ( $allowRendering = false )
#end

#if ( $allowRendering == true )
	#if ( !$docsQuery || $docsQuery.trim().equals("") )
		$widgetContext.renderWarning("$warnNoQuery")
		#set ( $allowRendering = false )
	#end
#end

## ==========================================================================
## MACROS
## ==========================================================================

## -------------------------------------------------------------------------
## Prefix the Data Set Lucene query with project.id when the query does not already scope by project.
## -------------------------------------------------------------------------
#macro ( resolveDocsQueryMacro $p_projectId $p_docsQuery $r_query )
	#set ( $r_query = $p_docsQuery )
	#if ( $p_projectId && !$p_docsQuery.contains("project.id:") )
		#set ( $r_query = "project.id:$p_projectId AND ($p_docsQuery)" )
	#end
#end

## -------------------------------------------------------------------------
## Search documents via $transaction.documents().search(); sort by "updated" or "space title" per widget parameter.
## -------------------------------------------------------------------------
#macro ( loadDocumentsMacro $p_query $p_sortByUpdated $r_docs )
	#if ( true == $p_sortByUpdated )
		#set ( $r_docs = $transaction.documents().search().query($p_query).sort("updated") )
	#end
	#if ( false == $p_sortByUpdated )
		#set ( $r_docs = $transaction.documents().search().query($p_query).sort("space title") )
	#end
#end

## -------------------------------------------------------------------------
## Copy search results into a list, skipping documents that are unresolvable in this transaction.
## -------------------------------------------------------------------------
#macro ( buildDocListMacro $p_docs $r_docList )
	#set ( $r_docList = [] )
	#foreach ( $d in $p_docs )
		#if ( !$d.isUnresolvable() )
			#set ( $void = $r_docList.add($d) )
		#end
	#end
#end

## -------------------------------------------------------------------------
## Render one document field with $doc.fields().get($fieldId).render() when readable; otherwise show an em dash.
## -------------------------------------------------------------------------
#macro ( renderDocFieldIfPresentMacro $doc $fieldId )
	#if ( $doc.fields().get($fieldId).getIfCan() )
		$!doc.fields().get($fieldId).render()
	#else
		<span style="color:#999;">—</span>
	#end
#end

## -------------------------------------------------------------------------
## Show last editor from the first readable field in $editorFieldIds (updatedBy, author, modifiedBy); otherwise an em dash.
## -------------------------------------------------------------------------
#macro ( renderLastEditorMacro $doc )
	#set ( $rendered = false )
	#foreach ( $fid in $editorFieldIds )
		#if ( !$rendered && $doc.fields().get($fid).getIfCan() )
			$!doc.fields().get($fid).render()
			#set ( $rendered = true )
		#end
	#end
	#if ( !$rendered )
		<span style="color:#999;">—</span>
	#end
#end

## -------------------------------------------------------------------------
## Open the Polarion-styled HTML table and tbody for the document list.
## -------------------------------------------------------------------------
#macro ( renderTableStartMacro )
	<table class="polarion-Document-table" style="margin:auto;border-collapse:collapse;width:90%;border:1px solid #CCCCCC;">
	<tbody>
#end

## -------------------------------------------------------------------------
## Close the table and render a centered footer with project id and document count.
## -------------------------------------------------------------------------
#macro ( renderTableEndMacro $p_count )
	</tbody>
	</table>
	<p style="text-align:center;font-size:smaller;color:#666;">project $projectId · $p_count document(s)</p>
#end

## -------------------------------------------------------------------------
## Output column headers (optional Space, Document, Status, Last edited by, Last updated).
## -------------------------------------------------------------------------
#macro ( renderTableHeaderMacro )
	<tr>
		#if ( true == $showSpaceColumn )
			<th style="text-align:left;padding:6px;background-color:#d3d3d3;border:1px solid #CCC;">Space</th>
		#end
		<th style="text-align:left;padding:6px;background-color:#d3d3d3;border:1px solid #CCC;">Document</th>
		<th style="text-align:center;padding:6px;background-color:#d3d3d3;border:1px solid #CCC;">Status</th>
		<th style="text-align:center;padding:6px;background-color:#d3d3d3;border:1px solid #CCC;">Last edited by</th>
		<th style="text-align:center;padding:6px;background-color:#d3d3d3;border:1px solid #CCC;">Last updated</th>
	</tr>
#end

## -------------------------------------------------------------------------
## Render one table row: space (optional), linked document title, status, last editor, last updated.
## -------------------------------------------------------------------------
#macro ( renderDocumentRowMacro $doc )
	<tr>
		#if ( true == $showSpaceColumn )
			<td style="text-align:left;padding:5px;border:1px solid #CCC;">$!doc.space().render()</td>
		#end
		<td style="text-align:left;padding:5px;border:1px solid #CCC;">$doc.render().withSpace(true).withLinks(true)</td>
		<td style="text-align:center;padding:5px;border:1px solid #CCC;">#renderDocFieldIfPresentMacro($doc "status")</td>
		<td style="text-align:center;padding:5px;border:1px solid #CCC;">#renderLastEditorMacro($doc)</td>
		<td style="text-align:center;padding:5px;border:1px solid #CCC;">#renderDocFieldIfPresentMacro($doc $updatedFieldId)</td>
	</tr>
#end

## -------------------------------------------------------------------------
## Emit all document rows; when sorted by last updated, iterate the list in reverse so newest appears first.
## -------------------------------------------------------------------------
#macro ( renderDocumentRowsMacro $p_docList )
	#if ( true == $sortByLastUpdated )
		#set ( $rowIndex = $p_docList.size() - 1 )
		#foreach ( $ignored in $p_docList )
			#renderDocumentRowMacro($p_docList.get($rowIndex))
			#set ( $rowIndex = $rowIndex - 1 )
		#end
	#else
		#foreach ( $doc in $p_docList )
			#renderDocumentRowMacro($doc)
		#end
	#end
#end

## ==========================================================================
## Main
## ==========================================================================

#if ( $allowRendering == true )
	#resolveDocsQueryMacro($projectId $docsQuery $effectiveQuery)
	#loadDocumentsMacro($effectiveQuery $sortByLastUpdated $docs)
	#buildDocListMacro($docs $docList)

	#if ( $docList.size() == 0 )
		$widgetContext.renderWarning("No documents matched the Data Set query.")
	#else
		#renderTableStartMacro()
		#renderTableHeaderMacro()
		#renderDocumentRowsMacro($docList)
		#renderTableEndMacro($docList.size())
	#end
#end
